<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/uap"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/foundation/windows10/uap/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/foundation/windows10/uap/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/foundation/windows10/desktop"
  IgnorableNamespaces="uap uap3 uap5 rescap desktop">

  <Identity
    Name="GlitchSlayed.LeanShell"
    Publisher="@PUBLISHER@"
    Version="@MSIX_VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>LeanShell</DisplayName>
    <PublisherDisplayName>LeanShell Contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Lightweight native Win32 + Direct2D shell, dock/panel, launcher, and window manager for Windows 11.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="LeanShell" Executable="leanshell.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="LeanShell"
        Description="Native Windows 11 shell, dock, launcher, and window manager"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="LeanShellStartup" Enabled="false" DisplayName="LeanShell" />
        </uap5:Extension>
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="leanshell.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

    <Application Id="LeanShellSettings" Executable="leanshell-settings.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="LeanShell Settings"
        Description="Configure LeanShell appearance, shell takeover, and window manager"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="leanshell-settings.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
